---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout slug="color-lab">
  <div class="cl-app" id="cl-app">
    <div class="cl-tabbar">
    <div class="tabs cl-tabs" role="tablist" aria-label="Color Lab sections" data-tabs="cl">
      <button class="tab" role="tab" data-tab="convert" id="cl-tab-convert" aria-controls="cl-panel-convert" aria-selected="true">Convert</button>
      <button class="tab" role="tab" data-tab="contrast" id="cl-tab-contrast" aria-controls="cl-panel-contrast">Contrast</button>
      <button class="tab" role="tab" data-tab="palette" id="cl-tab-palette" aria-controls="cl-panel-palette">Palette</button>
      <button class="tab" role="tab" data-tab="gradient" id="cl-tab-gradient" aria-controls="cl-panel-gradient">Gradient</button>
      <button class="tab" role="tab" data-tab="image" id="cl-tab-image" aria-controls="cl-panel-image">From image</button>
      <button class="tab" role="tab" data-tab="vision" id="cl-tab-vision" aria-controls="cl-panel-vision">Vision check</button>
    </div>
      <button class="btn btn-sm cl-share" id="cl-share" type="button" title="Copy a link to this tab's current state">Copy share link</button>
    </div>

    <!-- ============================================================ Convert -->
    <section class="cl-panel" data-tabpanel="cl:convert" id="cl-panel-convert" role="tabpanel" aria-labelledby="cl-tab-convert">
      <div class="cl-convert-top">
        <div class="cl-big-swatch cl-checker" aria-hidden="true"><div id="cv-swatch"></div></div>
        <div class="stack cl-convert-controls">
          <div class="field">
            <label class="label" for="cv-input">Any CSS color</label>
            <div class="cl-input-row">
              <input type="color" id="cv-picker" aria-label="Pick a color" />
              <input class="input mono" id="cv-input" spellcheck="false" autocomplete="off" placeholder="#ff0000, rgb(255 0 0), oklch(62.8% 0.258 29), tomato…" />
              <button class="btn btn-icon" id="cv-eyedrop" type="button" title="Pick a color from the screen" aria-label="Pick a color from the screen" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 22 1-1h3l9-9"/><path d="M3 21v-3l9-9"/><path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z"/></svg>
              </button>
              <button class="btn btn-icon" id="cv-random" type="button" title="Random color" aria-label="Random color">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>
              </button>
            </div>
            <div class="small cl-error" id="cv-error" role="alert" hidden></div>
          </div>
          <div class="row" id="cv-badges"></div>
          <div class="row cl-named">
            <span class="small muted">Nearest named color</span>
            <button class="btn btn-sm" id="cv-named" type="button"><span class="cl-dot" id="cv-named-dot"></span><span id="cv-named-text">–</span></button>
          </div>
          <div class="row cl-sendto">
            <span class="small muted">Send to</span>
            <button class="btn btn-sm" type="button" data-send="fg">Contrast text</button>
            <button class="btn btn-sm" type="button" data-send="bg">Contrast background</button>
            <button class="btn btn-sm" type="button" data-send="base">Palette base</button>
            <button class="btn btn-sm" type="button" data-send="stop">Gradient stop</button>
          </div>
        </div>
      </div>

      <div class="cl-convert-grid">
        <div class="panel">
          <div class="panel-header"><span>Adjust</span><span class="faint small">Drag or use arrow keys</span></div>
          <div class="panel-body stack">
            <fieldset class="cl-sliders">
              <legend class="cl-legend">OKLCH</legend>
              <div class="cl-slider"><label for="cv-ok-l">L</label><input type="range" id="cv-ok-l" min="0" max="100" step="0.1" /><output id="cv-ok-l-out" for="cv-ok-l"></output></div>
              <div class="cl-slider"><label for="cv-ok-c">C</label><input type="range" id="cv-ok-c" min="0" max="0.4" step="0.001" /><output id="cv-ok-c-out" for="cv-ok-c"></output></div>
              <div class="cl-slider"><label for="cv-ok-h">H</label><input type="range" id="cv-ok-h" min="0" max="360" step="0.1" /><output id="cv-ok-h-out" for="cv-ok-h"></output></div>
              <div class="cl-slider"><label for="cv-ok-a">A</label><input type="range" id="cv-ok-a" min="0" max="100" step="1" /><output id="cv-ok-a-out" for="cv-ok-a"></output></div>
            </fieldset>
            <fieldset class="cl-sliders">
              <legend class="cl-legend">HSL</legend>
              <div class="cl-slider"><label for="cv-hsl-h">H</label><input type="range" id="cv-hsl-h" min="0" max="360" step="0.5" /><output id="cv-hsl-h-out" for="cv-hsl-h"></output></div>
              <div class="cl-slider"><label for="cv-hsl-s">S</label><input type="range" id="cv-hsl-s" min="0" max="100" step="0.5" /><output id="cv-hsl-s-out" for="cv-hsl-s"></output></div>
              <div class="cl-slider"><label for="cv-hsl-l">L</label><input type="range" id="cv-hsl-l" min="0" max="100" step="0.5" /><output id="cv-hsl-l-out" for="cv-hsl-l"></output></div>
            </fieldset>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header"><span>All formats</span><span class="faint small" id="cv-mapped-note" hidden>* gamut-mapped to sRGB</span></div>
          <div class="panel-body">
            <ul class="cl-formats" id="cv-formats"></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ Contrast -->
    <section class="cl-panel" data-tabpanel="cl:contrast" id="cl-panel-contrast" role="tabpanel" aria-labelledby="cl-tab-contrast" hidden>
      <div class="cl-contrast">
        <div class="stack">
          <div class="card stack">
            <div class="field">
              <label class="label" for="ct-fg">Text (foreground)</label>
              <div class="cl-input-row">
                <input type="color" id="ct-fg-picker" aria-label="Pick text color" />
                <input class="input mono" id="ct-fg" spellcheck="false" autocomplete="off" />
              </div>
              <div class="small cl-error" id="ct-fg-error" role="alert" hidden></div>
            </div>
            <div class="row"><button class="btn btn-sm" id="ct-swap" type="button" title="Swap text and background">⇅ Swap</button></div>
            <div class="field">
              <label class="label" for="ct-bg">Background</label>
              <div class="cl-input-row">
                <input type="color" id="ct-bg-picker" aria-label="Pick background color" />
                <input class="input mono" id="ct-bg" spellcheck="false" autocomplete="off" />
              </div>
              <div class="small cl-error" id="ct-bg-error" role="alert" hidden></div>
            </div>
          </div>

          <div class="card stack">
            <div class="cl-ratio-row">
              <div>
                <div class="label">WCAG 2.2 contrast ratio</div>
                <div class="cl-ratio"><span id="ct-ratio">–</span><span class="cl-ratio-unit">:1</span></div>
              </div>
              <div class="cl-apca">
                <div class="label">APCA <abbr title="Lightness contrast">Lc</abbr></div>
                <div class="cl-apca-val" id="ct-apca">–</div>
                <div class="small muted" id="ct-apca-note"></div>
              </div>
            </div>
            <table class="table cl-wcag" aria-label="WCAG results">
              <thead><tr><th scope="col">Use</th><th scope="col">AA</th><th scope="col">AAA</th></tr></thead>
              <tbody id="ct-results"></tbody>
            </table>
          </div>
        </div>

        <div class="stack">
          <div class="cl-preview" id="ct-preview">
            <p class="cl-prev-normal" id="ct-prev-normal">Normal text, 16px. The quick brown fox jumps over the lazy dog, then reads the fine print on a sunny afternoon.</p>
            <p class="cl-prev-large" id="ct-prev-large">Large text, 24px</p>
            <p class="cl-prev-bold">Bold large text, 18.66px</p>
            <div class="cl-prev-ui" aria-label="UI component preview">
              <span class="cl-prev-btn">Button</span>
              <span class="cl-prev-field">Input field</span>
              <svg class="cl-prev-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
            </div>
          </div>

          <div class="card stack">
            <div class="row-between">
              <h3 class="cl-h">Suggest a passing text color</h3>
            </div>
            <p class="small muted cl-p">Finds the closest text color that passes, changing only OKLCH lightness (hue and chroma stay).</p>
            <div class="row">
              <label class="sr-only" for="ct-target">Target</label>
              <select class="select cl-select-auto" id="ct-target">
                <option value="aa">AA normal text (4.5:1)</option>
                <option value="aaa">AAA normal text (7:1)</option>
                <option value="aa-large">AA large text / UI (3:1)</option>
                <option value="aaa-large">AAA large text (4.5:1)</option>
              </select>
              <button class="btn btn-primary" id="ct-suggest" type="button">Suggest</button>
            </div>
            <div id="ct-suggestion" class="cl-suggestion" aria-live="polite"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ Palette -->
    <section class="cl-panel" data-tabpanel="cl:palette" id="cl-panel-palette" role="tabpanel" aria-labelledby="cl-tab-palette" hidden>
      <div class="card cl-pal-controls">
        <div class="field">
          <label class="label" for="pl-base">Base color</label>
          <div class="cl-input-row">
            <input type="color" id="pl-base-picker" aria-label="Pick base color" />
            <input class="input mono" id="pl-base" spellcheck="false" autocomplete="off" />
          </div>
          <div class="small cl-error" id="pl-error" role="alert" hidden></div>
        </div>
        <div class="field">
          <label class="label" for="pl-harmony">Harmony</label>
          <select class="select" id="pl-harmony"></select>
        </div>
        <div class="field">
          <label class="label" for="pl-name">Scale name</label>
          <input class="input" id="pl-name" value="brand" spellcheck="false" autocomplete="off" />
        </div>
        <div class="field cl-shuffle-field">
          <span class="label" aria-hidden="true">&nbsp;</span>
          <button class="btn btn-primary" id="pl-shuffle" type="button">Shuffle <kbd class="cl-kbd">Space</kbd></button>
        </div>
      </div>

      <div class="cl-section-head"><h3 class="cl-h">Palette</h3><span class="small muted">Lock colors you like, then shuffle the rest.</span></div>
      <div class="cl-palette" id="pl-swatches"></div>

      <div class="cl-section-head"><h3 class="cl-h">Tonal scale</h3><span class="small muted">50–950 in OKLCH, Tailwind-style. Click a step to copy.</span></div>
      <div class="cl-scale" id="pl-scale"></div>

      <div class="panel cl-export">
        <div class="panel-header">
          <div class="btn-group" role="group" aria-label="Export format">
            <button class="btn btn-sm" type="button" data-export="css" aria-pressed="true">CSS variables</button>
            <button class="btn btn-sm" type="button" data-export="tailwind" aria-pressed="false">Tailwind</button>
            <button class="btn btn-sm" type="button" data-export="json" aria-pressed="false">JSON</button>
          </div>
          <div class="row">
            <button class="btn btn-sm" id="pl-copy" type="button">Copy</button>
            <button class="btn btn-sm" id="pl-download" type="button">Download</button>
            <button class="btn btn-sm" id="pl-svg" type="button">SVG image</button>
            <button class="btn btn-sm" id="pl-png" type="button">PNG image</button>
          </div>
        </div>
        <label class="sr-only" for="pl-code">Export code</label>
        <textarea class="textarea code-input cl-code" id="pl-code" readonly spellcheck="false"></textarea>
      </div>
    </section>

    <!-- ============================================================ Gradient -->
    <section class="cl-panel" data-tabpanel="cl:gradient" id="cl-panel-gradient" role="tabpanel" aria-labelledby="cl-tab-gradient" hidden>
      <div class="cl-grad-preview cl-checker"><div id="gr-preview"></div></div>

      <div class="card stack">
        <div class="cl-grad-controls">
          <div class="field">
            <span class="label" id="gr-type-label">Type</span>
            <div class="btn-group" role="group" aria-labelledby="gr-type-label">
              <button class="btn btn-sm" type="button" data-gtype="linear">Linear</button>
              <button class="btn btn-sm" type="button" data-gtype="radial">Radial</button>
              <button class="btn btn-sm" type="button" data-gtype="conic">Conic</button>
            </div>
          </div>
          <div class="field cl-angle-field">
            <label class="label" for="gr-angle">Angle</label>
            <div class="cl-angle-row">
              <input type="range" id="gr-angle" min="0" max="360" step="1" />
              <input class="input cl-num" type="number" id="gr-angle-num" min="0" max="360" step="1" aria-label="Angle in degrees" />
            </div>
          </div>
          <div class="field">
            <span class="label" id="gr-space-label">Interpolation</span>
            <div class="btn-group" role="group" aria-labelledby="gr-space-label">
              <button class="btn btn-sm" type="button" data-gspace="srgb">sRGB</button>
              <button class="btn btn-sm" type="button" data-gspace="oklab">OKLab</button>
              <button class="btn btn-sm" type="button" data-gspace="oklch">OKLCH</button>
            </div>
          </div>
        </div>

        <div class="field">
          <span class="label" id="gr-bar-label">Stops</span>
          <div class="cl-stopbar-wrap">
            <div class="cl-stopbar cl-checker" id="gr-bar" aria-labelledby="gr-bar-label"><div id="gr-bar-fill"></div></div>
            <div class="cl-stop-handles" id="gr-handles"></div>
          </div>
          <div class="small faint">Click the bar to add a stop. Drag handles to move them (arrow keys work too). <kbd>Delete</kbd> removes the selected stop.</div>
        </div>

        <div class="cl-stop-editor">
          <div class="field">
            <label class="label" for="gr-stop-color">Selected stop color</label>
            <div class="cl-input-row">
              <input type="color" id="gr-stop-picker" aria-label="Pick stop color" />
              <input class="input mono" id="gr-stop-color" spellcheck="false" autocomplete="off" />
            </div>
          </div>
          <div class="field">
            <label class="label" for="gr-stop-pos">Position %</label>
            <input class="input cl-num" type="number" id="gr-stop-pos" min="0" max="100" step="1" />
          </div>
          <div class="row cl-stop-actions">
            <button class="btn btn-sm btn-danger" id="gr-remove" type="button">Remove stop</button>
            <button class="btn btn-sm" id="gr-reverse" type="button">Reverse</button>
            <button class="btn btn-sm" id="gr-random" type="button">Random</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header"><span>CSS</span><button class="btn btn-sm" id="gr-copy" type="button">Copy CSS</button></div>
        <pre class="cl-pre" id="gr-css"></pre>
      </div>

      <div class="card stack">
        <div class="cl-section-head cl-section-head-tight"><h3 class="cl-h">Compare interpolation spaces</h3><span class="small muted">Same stops, different math</span></div>
        <div class="cl-compare" id="gr-compare"></div>
      </div>
    </section>

    <!-- ============================================================ Image -->
    <section class="cl-panel" data-tabpanel="cl:image" id="cl-panel-image" role="tabpanel" aria-labelledby="cl-tab-image" hidden>
      <div class="cl-image-grid">
        <div class="stack">
          <div class="dropzone cl-drop" id="im-drop" aria-label="Drop an image or click to choose one">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>
            <div><strong>Drop an image</strong> or click to choose</div>
            <div class="small faint">PNG, JPEG, WebP, GIF, SVG. Processed on this device only.</div>
          </div>
          <div class="row">
            <button class="btn btn-sm" id="im-sample" type="button">Load sample image</button>
            <label class="small muted" for="im-k">Colors</label>
            <input type="range" id="im-k" min="5" max="10" step="1" value="6" class="cl-k" />
            <output id="im-k-out" for="im-k" class="mono small">6</output>
          </div>
          <div class="small cl-error" id="im-error" role="alert" hidden></div>
          <div class="cl-image-wrap" id="im-wrap" hidden><canvas id="im-canvas" aria-label="Loaded image"></canvas></div>
        </div>
        <div class="stack">
          <div class="cl-empty" id="im-empty">Drop an image to pull its colors, or load the sample.</div>
          <div class="cl-im-bar" id="im-bar" aria-hidden="true"></div>
          <div class="cl-im-list" id="im-list" role="listbox" aria-label="Extracted colors"></div>
          <div class="card stack" id="im-actions" hidden>
            <div class="small muted">Selected: <strong id="im-selected" class="mono"></strong></div>
            <div class="row">
              <button class="btn btn-sm" type="button" data-imsend="convert">Convert</button>
              <button class="btn btn-sm" type="button" data-imsend="fg">Contrast text</button>
              <button class="btn btn-sm" type="button" data-imsend="bg">Contrast background</button>
              <button class="btn btn-sm" type="button" data-imsend="base">Palette base</button>
              <button class="btn btn-sm" type="button" data-imsend="stop">Gradient stop</button>
            </div>
            <div class="row">
              <button class="btn btn-sm btn-primary" type="button" id="im-to-palette">Use as palette</button>
              <button class="btn btn-sm" type="button" id="im-to-gradient">Make gradient</button>
              <button class="btn btn-sm" type="button" id="im-to-vision">Check in Vision</button>
              <button class="btn btn-sm" type="button" id="im-copy">Copy hex list</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ Vision -->
    <section class="cl-panel" data-tabpanel="cl:vision" id="cl-panel-vision" role="tabpanel" aria-labelledby="cl-tab-vision" hidden>
      <div class="card stack">
        <div class="field">
          <label class="label" for="vs-input">Colors to check (comma or space separated)</label>
          <input class="input mono" id="vs-input" spellcheck="false" autocomplete="off" />
          <div class="small cl-error" id="vs-error" role="alert" hidden></div>
        </div>
        <div class="row">
          <span class="small muted">Load from</span>
          <button class="btn btn-sm" type="button" id="vs-from-palette">Palette</button>
          <button class="btn btn-sm" type="button" id="vs-from-scale">Tonal scale</button>
          <button class="btn btn-sm" type="button" id="vs-from-image">Image colors</button>
        </div>
      </div>
      <div class="cl-vision" id="vs-grid"></div>
      <div class="card stack" id="vs-image-card" hidden>
        <div class="cl-section-head cl-section-head-tight"><h3 class="cl-h">Your image</h3><span class="small muted">From the From image tab</span></div>
        <div class="cl-vision-images" id="vs-images"></div>
      </div>
      <p class="small faint">Simulation uses the Machado, Oliveira &amp; Fernandes (2009) matrices at full severity in linear RGB; achromatopsia uses Rec. 709 luminance. Results are approximations; real perception varies.</p>
    </section>
  </div>
</ToolLayout>

<script>
  import { init } from '../../tools/color-lab/main';
  init();
</script>

<style is:global>
  .cl-app { display: flex; flex-direction: column; gap: 16px; }
  .cl-tabbar { display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--border); }
  .cl-tabs { flex: 1 1 auto; min-width: 0; border-bottom: 0; }
  .cl-share { flex: none; }
  .cl-panel { display: flex; flex-direction: column; gap: 16px; }
  .cl-panel[hidden] { display: none; }
  .cl-h { margin: 0; font-size: 1rem; }
  .cl-p { margin: 0; }
  .cl-error { color: var(--danger); }
  .cl-legend { font-size: 0.8rem; font-weight: 650; color: var(--text-muted); padding: 0; margin-bottom: 6px; letter-spacing: 0.04em; }
  .cl-section-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: -6px; }
  .cl-section-head-tight { margin-bottom: 0; }
  .cl-checker {
    background-color: #fff;
    background-image: conic-gradient(#d9d9d9 25%, transparent 0 50%, #d9d9d9 0 75%, transparent 0);
    background-size: 16px 16px;
  }
  .cl-input-row { display: flex; gap: 8px; align-items: center; }
  .cl-input-row > input[type='color'] { flex: none; }
  .cl-input-row > .input { flex: 1 1 auto; min-width: 0; }
  .cl-input-row > .btn { flex: none; }
  .cl-dot { display: inline-block; width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border-strong); flex: none; }
  .cl-select-auto { width: auto; max-width: 100%; }
  .cl-num { width: 84px; }
  .cl-kbd { margin-left: 4px; background: transparent; color: inherit; border-color: currentColor; opacity: 0.85; }

  /* Convert */
  .cl-convert-top { display: grid; grid-template-columns: minmax(180px, 280px) 1fr; gap: 16px; align-items: stretch; }
  .cl-big-swatch { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); min-height: 180px; position: relative; }
  .cl-big-swatch > div { position: absolute; inset: 0; }
  .cl-convert-controls { min-width: 0; justify-content: center; }
  .cl-named, .cl-sendto { gap: 6px; }
  .cl-convert-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 16px; }
  .cl-sliders { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .cl-slider { display: grid; grid-template-columns: 18px 1fr 76px; align-items: center; gap: 10px; }
  .cl-slider label { font-weight: 650; font-size: 0.85rem; color: var(--text-muted); }
  .cl-slider output { font-family: var(--font-mono); font-size: 0.8rem; text-align: right; color: var(--text); }
  .cl-slider input[type='range'] {
    -webkit-appearance: none; appearance: none; height: 14px; border-radius: 999px; margin: 6px 0;
    background: var(--track, var(--bg-sunken)); border: 1px solid var(--border); cursor: pointer;
  }
  .cl-slider input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
