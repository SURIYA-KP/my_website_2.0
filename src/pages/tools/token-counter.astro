---
import ToolLayout from '../../layouts/ToolLayout.astro';

const encodings = [
  { name: 'o200k_base', models: 'GPT-4o, GPT-4.1, o-series' },
  { name: 'cl100k_base', models: 'GPT-4, GPT-3.5, embeddings' },
  { name: 'p50k_base', models: 'Codex, text-davinci' },
];
const examples = [
  { key: 'prose', label: 'Prose' },
  { key: 'code', label: 'Code' },
  { key: 'json', label: 'JSON' },
  { key: 'multilingual', label: 'Multilingual' },
  { key: 'emoji', label: 'Emoji' },
];
---
<ToolLayout slug="token-counter" wide>
  <div class="tc" id="tc-root">
    <div class="tabs" role="tablist" data-tabs="tc" aria-label="Mode">
      <button class="tab" role="tab" data-tab="count" aria-selected="true" id="tc-tab-count">Count &amp; visualize</button>
      <button class="tab" role="tab" data-tab="compare" id="tc-tab-compare">Compare encodings</button>
      <button class="tab" role="tab" data-tab="decode" id="tc-tab-decode">Decode ids</button>
    </div>

    <!-- ============ COUNT ============ -->
    <section data-tabpanel="tc:count" class="tc-panel stack" aria-labelledby="tc-tab-count">
      <div class="tc-controls">
        <div class="tc-enc" role="radiogroup" aria-label="Encoding" id="tc-enc">
          {encodings.map((e, i) => (
            <button type="button" class="tc-enc-btn" role="radio" data-enc={e.name} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="tc-enc-name mono">{e.name}</span>
              <span class="tc-enc-models">{e.models}</span>
            </button>
          ))}
        </div>
        <div class="tc-controls-side">
          <div class="tc-pop-wrap">
            <button type="button" class="btn btn-sm" id="tc-info-btn" aria-expanded="false" aria-controls="tc-info">
              <span aria-hidden="true" class="tc-i">i</span> Which models use which?
            </button>
            <div class="tc-pop" id="tc-info" role="dialog" aria-label="Encodings and models" hidden>
              <h3>Encodings and models</h3>
              <dl>
                <dt class="mono">o200k_base</dt>
                <dd>Listed by OpenAI's open-source tiktoken mappings for GPT-4o and GPT-4o mini, the GPT-4.1 family, the o-series reasoning models (o1, o3, o4-mini) and GPT-5. Most current OpenAI models use it.</dd>
                <dt class="mono">cl100k_base</dt>
                <dd>GPT-4 and GPT-4 Turbo, GPT-3.5 Turbo, and the embedding models text-embedding-3-small/-large and text-embedding-ada-002.</dd>
                <dt class="mono">p50k_base</dt>
                <dd>Older completion models such as text-davinci-002/003 and Codex.</dd>
              </dl>
              <p class="small muted">Mappings follow the tiktoken library bundled here (js-tiktoken 1.0.21) and may not cover the newest models; check the provider's docs. Chat APIs add a few formatting tokens per message, so billed input can be slightly higher than the raw count.</p>
              <p class="small muted">Claude, Gemini and Llama use their own tokenizers, which are not available offline. Their figures below are rough estimates derived from the o200k count, never exact.</p>
            </div>
          </div>
          <label class="checkbox small" title="When on, strings like <|endoftext|> become single special tokens instead of plain text">
            <input type="checkbox" id="tc-special" /> Parse special tokens
          </label>
        </div>
      </div>

      <div class="tc-stats card" aria-live="polite" id="tc-stats">
        <div class="tc-stat tc-stat-main">
          <span class="tc-stat-label">Tokens</span>
          <span class="tc-stat-value" id="tc-count" data-count="">–</span>
          <span class="tc-status small" id="tc-status"></span>
        </div>
        <div class="tc-stat"><span class="tc-stat-label">Characters</span><span class="tc-stat-value" data-stat="chars">–</span></div>
        <div class="tc-stat"><span class="tc-stat-label">Words</span><span class="tc-stat-value" data-stat="words">–</span></div>
        <div class="tc-stat"><span class="tc-stat-label">Lines</span><span class="tc-stat-value" data-stat="lines">–</span></div>
        <div class="tc-stat"><span class="tc-stat-label">UTF-8 bytes</span><span class="tc-stat-value" data-stat="bytes">–</span></div>
        <div class="tc-stat"><span class="tc-stat-label">Chars / token</span><span class="tc-stat-value" data-stat="cpt">–</span></div>
        <div class="tc-stat"><span class="tc-stat-label">Tokens / word</span><span class="tc-stat-value" data-stat="tpw">–</span></div>
      </div>

      <div class="split tc-work">
        <div class="panel">
          <div class="panel-header">
            <label for="tc-input">Text</label>
            <div class="row tc-examples" role="group" aria-label="Load an example">
              <span class="small faint">Examples:</span>
              {examples.map((x) => <button type="button" class="btn btn-sm btn-ghost" data-example={x.key}>{x.label}</button>)}
            </div>
          </div>
          <div class="panel-body tc-input-body">
            <textarea id="tc-input" class="textarea tc-textarea" spellcheck="false" placeholder="Type or paste text here…"></textarea>
            <div class="row-between tc-input-foot">
              <div class="dropzone tc-drop" id="tc-drop" aria-label="Open a text file">
                <strong>Drop a text file</strong> <span class="muted">or click to open (.txt, .md, .json, code)</span>
              </div>
              <button type="button" class="btn btn-sm" id="tc-clear">Clear</button>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-header">
            <span id="tc-tokens-title">Tokens</span>
            <div class="row">
              <button type="button" class="btn btn-sm" id="tc-toggle-ids" aria-pressed="false">Show ids</button>
              <button type="button" class="btn btn-sm" id="tc-toggle-ws" aria-pressed="false">Show whitespace</button>
              <button type="button" class="btn btn-sm" id="tc-copy-ids">Copy ids</button>
              <button type="button" class="btn btn-sm" id="tc-download">Download JSON</button>
            </div>
          </div>
          <div class="panel-body tc-chips-body">
            <div class="tc-chips" id="tc-chips" aria-label="Tokens. Use arrow keys to move between tokens." role="group"></div>
            <div class="tc-more small" id="tc-more" hidden>
              <span data-more-text></span> <button type="button" class="btn btn-sm">Show more</button>
            </div>
          </div>
        </div>
      </div>

      <div class="tc-cards">
        <div class="card tc-card">
          <div class="row-between tc-card-head">
            <h2>Context window</h2>
            <button type="button" class="btn btn-sm btn-ghost" id="tc-ctx-reset">Reset</button>
          </div>
          <p class="small muted tc-card-sub">Share of each context size used by this text<span id="tc-ctx-out-note"> plus expected output</span>. Sizes are editable.</p>
          <div id="tc-ctx" class="tc-ctx"></div>
        </div>

        <div class="card tc-card">
          <h2>Cost estimate</h2>
          <div class="tc-cost-grid">
            <label class="field tc-span2"><span class="label">Price preset</span>
              <select class="select" id="tc-preset"></select>
            </label>
            <label class="field"><span class="label">Input $ / 1M tokens</span>
              <input class="input" type="number" min="0" step="0.01" id="tc-price-in" inputmode="decimal" />
            </label>
            <label class="field"><span class="label">Output $ / 1M tokens</span>
              <input class="input" type="number" min="0" step="0.01" id="tc-price-out" inputmode="decimal" />
            </label>
            <label class="field"><span class="label">Expected output tokens</span>
              <input class="input" type="number" min="0" step="1" id="tc-out-tokens" value="500" inputmode="numeric" />
            </label>
            <label class="field"><span class="label">Requests</span>
              <input class="input" type="number" min="1" step="1" id="tc-requests" value="1" inputmode="numeric" />
            </label>
            <label class="field tc-span2"><span class="label">Input token count to use</span>
              <select class="select" id="tc-basis"></select>
            </label>
          </div>
          <dl class="tc-cost-out" id="tc-cost-out">
            <div><dt>Input</dt><dd data-cost="input">–</dd></div>
            <div><dt>Output</dt><dd data-cost="output">–</dd></div>
            <div><dt>Per request</dt><dd data-cost="per">–</dd></div>
            <div class="tc-cost-total"><dt>Total <span id="tc-cost-req" class="faint"></span></dt><dd data-cost="total">–</dd></div>
          </dl>
          <p class="small faint tc-note">Presets are examples only, check current pricing. Caching, batch discounts and per-message overhead are not included.</p>
        </div>

        <div class="card tc-card">
          <div class="row-between tc-card-head">
            <h2>Other model families</h2>
            <span class="badge badge-warning">Approximate</span>
          </div>
          <p class="small muted tc-card-sub">These tokenizers are not available offline. Estimates are the o200k count times a rule-of-thumb factor, shown with a ± range. Never treat them as exact.</p>
          <div id="tc-approx" class="tc-approx"></div>
          <p class="small faint tc-note">For exact numbers use the provider's own token-counting tool or API.</p>
        </div>
      </div>
    </section>

    <!-- ============ COMPARE ============ -->
    <section data-tabpanel="tc:compare" class="tc-panel stack" aria-labelledby="tc-tab-compare" hidden>
      <div class="tc-compare-bar card">
        <p class="small muted">Same text as in <em>Count &amp; visualize</em>, tokenized with two encodings.</p>
        <div class="tc-compare-summary" id="tc-cmp-summary" aria-live="polite"></div>
      </div>
      <div class="split">
        {['a', 'b'].map((side, i) => (
          <div class="panel">
            <div class="panel-header">
              <label class="row" style="gap:6px">
                <span>Encoding {side.toUpperCase()}</span>
                <select class="select tc-cmp-select" id={`tc-cmp-${side}`} data-side={side}>
                  {encodings.map((e, j) => <option value={e.name} selected={j === i}>{e.name}</option>)}
                </select>
              </label>
              <span class="tc-cmp-count" id={`tc-cmp-${side}-count`}>–</span>
            </div>
            <div class="panel-body tc-chips-body">
              <div class="tc-chips" id={`tc-cmp-${side}-chips`} role="group" aria-label={`Tokens for encoding ${side.toUpperCase()}`}></div>
              <div class="tc-more small" id={`tc-cmp-${side}-more`} hidden>
                <span data-more-text></span> <button type="button" class="btn btn-sm">Show more</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ DECODE ============ -->
    <section data-tabpanel="tc:decode" class="tc-panel stack" aria-labelledby="tc-tab-decode" hidden>
      <div class="split">
        <div class="panel">
          <div class="panel-header">
            <label for="tc-ids-input">Token ids</label>
            <label class="row" style="gap:6px"><span>Encoding</span>
              <select class="select tc-dec-select" id="tc-dec-enc">
                {encodings.map((e) => <option value={e.name}>{e.name}</option>)}
              </select>
            </label>
          </div>
          <div class="panel-body stack">
            <textarea id="tc-ids-input" class="textarea code-input tc-ids-input" spellcheck="false" placeholder="[9906, 1917]">[9906, 1917, 0]</textarea>
            <p class="small muted" style="margin:0">Paste ids as a JSON array or separated by spaces, commas or new lines.</p>
            <div id="tc-dec-error" class="alert alert-error" role="alert" hidden></div>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header">
            <span>Decoded text <span class="faint" id="tc-dec-meta"></span></span>
            <button type="button" class="btn btn-sm" id="tc-dec-copy">Copy text</button>
          </div>
          <div class="panel-body stack">
            <pre class="tc-dec-text" id="tc-dec-text" aria-live="polite"></pre>
            <div>
              <div class="label">Tokens</div>
              <div class="tc-chips tc-chips-small" id="tc-dec-chips" role="group" aria-label="Decoded tokens"></div>
              <div class="tc-more small" id="tc-dec-more" hidden><span data-more-text></span> <button type="button" class="btn btn-sm">Show more</button></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { init } from '../../tools/token-counter/main';
  init();
</script>

<style is:global>
  .tc { display: flex; flex-direction: column; gap: 14px; }
  .tc-panel { gap: 14px; }

  /* Encoding picker */
  .tc-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .tc-controls-side { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .tc-enc { display: flex; gap: 6px; flex-wrap: wrap; }
  .tc-enc-btn {
    appearance: none; font: inherit; cursor: pointer; text-align: left;
    display: flex; flex-direction: column; gap: 1px; padding: 6px 12px;
    border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    background: var(--bg-elev); color: var(--text);
    transition: border-color .12s, background .12s;
  }
  .tc-enc-btn:hover { background: var(--bg-hover); }
  .tc-enc-btn[aria-checked='true'] { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .tc-enc-name { font-size: 0.82rem; font-weight: 600; }
  .tc-enc-btn[aria-checked='true'] .tc-enc-name { color: var(--accent); }
  .tc-enc-models { font-size: 0.72rem; color: var(--text-muted); }
  .tc-i {
    display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%;
    border: 1.5px solid currentColor; font-size: 0.65rem; font-weight: 700; font-style: italic; font-family: Georgia, serif;
  }

  /* Info popover */
  .tc-pop-wrap { position: relative; }
  .tc-pop {
    position: absolute; right: 0; top: calc(100% + 6px); z-index: 50;
    width: min(420px, calc(100vw - 32px));
    background: var(--bg-elev); border: 1px solid var(--border-strong); border-radius: var(--radius);
    box-shadow: var(--shadow-lg); padding: 14px 16px; font-size: 0.875rem;
  }
  .tc-pop h3 { margin-bottom: 8px; }
  .tc-pop dl { margin: 0 0 10px; }
  .tc-pop dt { font-weight: 600; color: var(--accent); font-size: 0.82rem; }
  .tc-pop dd { margin: 2px 0 10px; color: var(--text); }
  .tc-pop p:last-child { margin-bottom: 0; }

  /* Stats strip */
  .tc-stats { display: grid; grid-template-columns: minmax(170px, 1.4fr) repeat(6, minmax(0, 1fr)); gap: 0; padding: 0; overflow: hidden; }
  .tc-stat { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border-left: 1px solid var(--border); min-width: 0; }
  .tc-stat:first-child { border-left: 0; }
  .tc-stat-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); }
  .tc-stat-value { font-size: 1.15rem; font-weight: 650; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tc-stat-main { background: var(--accent-soft); }
  .tc-stat-main .tc-stat-value { font-size: 1.9rem; line-height: 1.1; color: var(--accent); }
  .tc-status { color: var(--text-muted); min-height: 1.2em; display: flex; align-items: center; gap: 6px; }
  .tc-status.is-busy::before {
    content: ''; width: 10px; height: 10px; border-radius: 50%;
    border: 2px solid var(--accent); border-right-color: transparent; animation: tc-spin .8s linear infinite;
  }
  .tc-status.is-error { color: var(--danger); }
  @keyframes tc-spin { to { transform: rotate(360deg); } }
  @media (max-width: 1100px) {
    .tc-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tc-stat-main { grid-column: 1 / -1; flex-direction: row; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .tc-stat { border-top: 1px solid var(--border); }
    .tc-stat-main { border-top: 0; }
    .tc-stat:nth-child(3n + 2) { border-left: 0; }
  }

  /* Workspace */
  .tc-work .panel { height: clamp(360px, 58vh, 640px); }
  .tc-input-body { display: flex; flex-direction: column; gap: 8px; overflow: hidden; }
  .tc-textarea { flex: 1 1 auto; min-height: 0; resize: none; font-family: var(--font-mono); font-size: 13px; line-height: 1.6; }
  .tc-input-foot { flex-wrap: nowrap; align-items: stretch; }
  .tc-drop { flex: 1 1 auto; padding: 8px 12px; border-radius: var(--radius-sm); font-size: 0.8rem; text-align: left; border-width: 1.5px; }
  .tc-examples { gap: 2px; }
  .tc-examples .btn { padding: 0 7px; }

  /* Chips */
  .tc-chips-body { position: relative; }
  .tc-chips {
    font-family: var(--font-mono); font-size: 13px; line-height: 1.85;
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; color: var(--text);
  }
  .tc-chips.tc-ids { white-space: normal; display: flex; flex-wrap: wrap; gap: 4px; line-height: 1.5; }
  .tc-chip {
    border-radius: 3px; padding: 1px 0; cursor: default;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .tc-c0 { background: color-mix(in srgb, var(--c1) 18%, transparent); }
  .tc-c1 { background: color-mix(in srgb, var(--c5) 20%, transparent); }
  .tc-c2 { background: color-mix(in srgb, var(--c3) 22%, transparent); }
  .tc-c3 { background: color-mix(in srgb, var(--c4) 17%, transparent); }
  .tc-c4 { background: color-mix(in srgb, var(--c2) 20%, transparent); }
  .tc-chip:hover, .tc-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; position: relative; z-index: 1; }
  .tc-chip:focus { outline: 2px solid var(--accent); outline-offset: 0; }
  .tc-ids .tc-chip { padding: 0 6px; font-variant-numeric: tabular-nums; }
  .tc-ws .tc-chip { color: var(--text); }
  .tc-byte {
    display: inline-block; font-size: 0.68em; line-height: 1.2; padding: 0 2px; margin: 0 1px; vertical-align: 1px;
    border: 1px dashed var(--text-faint); border-radius: 3px; color: var(--text-muted);
  }
  .tc-empty { color: var(--text-faint); }
  .tc-chips-small { font-size: 12px; }
  .tc-placeholder { color: var(--text-faint); font-family: var(--font-sans); white-space: normal; }
  .tc-more { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-top: 12px; color: var(--text-muted); }

  /* Tooltip */
  .tc-tip {
    position: fixed; z-index: 1000; pointer-events: none; max-width: min(340px, calc(100vw - 16px));
    background: var(--text); color: var(--bg); border-radius: var(--radius-sm); padding: 8px 10px;
    font-size: 0.78rem; box-shadow: var(--shadow-lg); display: flex; flex-direction: column; gap: 3px;
  }
  .tc-tip-head { display: flex; justify-content: space-between; gap: 16px; opacity: 0.85; }
  .tc-tip-head strong { font-family: var(--font-mono); opacity: 1; }
  .tc-tip-text { font-family: var(--font-mono); white-space: pre-wrap; word-break: break-all; font-weight: 600; }
  .tc-tip-bytes { font-family: var(--font-mono); opacity: 0.8; word-break: break-all; }
  .tc-tip-note { opacity: 0.85; font-style: italic; }

  /* Cards */
  .tc-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
  @media (max-width: 1100px) { .tc-cards { grid-template-columns: 1fr 1fr; } .tc-cards > :last-child { grid-column: 1 / -1; } }
  @media (max-width: 720px) { .tc-cards { grid-template-columns: 1fr; } }
  .tc-card { min-width: 0; }
  .tc-card h2 { font-size: 1.02rem; margin: 0; }
  .tc-card-head { margin-bottom: 4px; }
  .tc-card > h2 { margin-bottom: 10px; }
  .tc-card-sub { margin: 0 0 12px; }
  .tc-note { margin: 12px 0 0; }

  .tc-ctx { display: flex; flex-direction: column; gap: 10px; }
  .tc-ctx-row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 4px 10px; align-items: center; }
  .tc-ctx-row .input { height: 30px; font-size: 0.82rem; font-variant-numeric: tabular-nums; padding: 4px 8px; }
  .tc-ctx-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 0.78rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .tc-ctx-meta strong { color: var(--text); font-weight: 600; }
  .tc-bar { position: relative; height: 8px; border-radius: 999px; background: var(--bg-sunken); overflow: hidden; border: 1px solid var(--border); }
  .tc-bar-in, .tc-bar-out { position: absolute; top: 0; bottom: 0; }
  .tc-bar-in { left: 0; background: var(--accent); border-radius: 999px 0 0 999px; }
  .tc-bar-out { background: repeating-linear-gradient(45deg, color-mix(in srgb, var(--accent) 55%, transparent) 0 3px, color-mix(in srgb, var(--accent) 25%, transparent) 3px 6px); }
  .tc-ctx-row.is-over .tc-bar-in { background: var(--danger); }
  .tc-ctx-row.is-over .tc-ctx-meta strong { color: var(--danger); }

  .tc-cost-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .tc-span2 { grid-column: 1 / -1; }
  .tc-cost-out { margin: 14px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .tc-cost-out > div { background: var(--bg-sunken); border-radius: var(--radius-sm); padding: 8px 10px; min-width: 0; }
  .tc-cost-out dt { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
  .tc-cost-out dd { margin: 0; font-weight: 650; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .tc-cost-total { background: var(--accent-soft) !important; }
  .tc-cost-total dd { color: var(--accent); font-size: 1.1rem; }

  .tc-approx { display: flex; flex-direction: column; gap: 10px; }
  .tc-approx-row { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; }
  .tc-approx-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .tc-approx-name { font-weight: 650; }
  .tc-approx-name small { font-weight: 500; color: var(--text-muted); margin-left: 4px; }
  .tc-approx-val { font-variant-numeric: tabular-nums; font-weight: 650; }
  .tc-approx-range { font-size: 0.8rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .tc-approx-note { font-size: 0.78rem; color: var(--text-muted); margin: 4px 0 0; }

  /* Compare */
  .tc-compare-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 16px; }
  .tc-compare-bar p { margin: 0; }
