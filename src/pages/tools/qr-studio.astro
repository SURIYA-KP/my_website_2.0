---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout slug="qr-studio">
  <div class="qrs" id="qrs-root">
    <div class="tabs no-print" role="tablist" aria-label="QR Studio mode" data-tabs="qrs">
      <button class="tab" role="tab" type="button" data-tab="create" id="qrs-tab-create" aria-controls="qrs-panel-create" aria-selected="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"/></svg>
        Create
      </button>
      <button class="tab" role="tab" type="button" data-tab="scan" id="qrs-tab-scan" aria-controls="qrs-panel-scan" aria-selected="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10"/></svg>
        Scan
      </button>
    </div>

    <!-- ============================ CREATE ============================ -->
    <section class="qrs-panel" data-tabpanel="qrs:create" id="qrs-panel-create" role="tabpanel" aria-labelledby="qrs-tab-create">
      <div class="qrs-grid">
        <div class="card qrs-content no-print">
          <h2 class="qrs-h"><span class="qrs-step">1</span> Content</h2>
          <div class="qrs-types" id="qrs-types" role="radiogroup" aria-label="Content type"></div>
          <form id="qrs-form" class="qrs-form" autocomplete="off" novalidate></form>
          <div id="qrs-form-error" class="alert alert-warning" role="status" hidden></div>
          <div class="qrs-payload-box">
            <div class="row-between">
              <label class="label" for="qrs-payload" style="margin:0">Encoded payload</label>
              <div class="row">
                <label class="checkbox small"><input type="checkbox" id="qrs-edit-raw" /> Edit raw text</label>
                <button type="button" class="btn btn-sm" id="qrs-copy-payload">Copy</button>
              </div>
            </div>
            <textarea id="qrs-payload" class="textarea code-input qrs-payload" rows="3" readonly spellcheck="false" aria-describedby="qrs-payload-hint"></textarea>
            <p class="small faint qrs-payload-hint" id="qrs-payload-hint">This exact text is stored in the code. Turn on “Edit raw text” to fine-tune it by hand.</p>
          </div>
        </div>

        <div class="card qrs-preview">
          <div class="row-between no-print">
            <h2 class="qrs-h" style="margin:0">Preview</h2>
            <div class="row" id="qrs-badges"></div>
          </div>
          <div class="qrs-stage" id="qrs-stage">
            <div class="qrs-svg" id="qrs-svg" aria-live="polite"></div>
            <div class="qrs-empty" id="qrs-empty" hidden>
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
              <span id="qrs-empty-text">Fill in the form to see your code.</span>
            </div>
          </div>
          <p class="qrs-print-caption" id="qrs-print-caption"></p>
          <div class="qrs-meter no-print" id="qrs-meter">
            <div class="row-between small"><span class="muted" id="qrs-cap-label">Capacity</span><span class="mono faint" id="qrs-cap-value"></span></div>
            <div class="qrs-bar" role="progressbar" aria-labelledby="qrs-cap-label" aria-valuemin="0" aria-valuemax="100" id="qrs-bar"><span id="qrs-bar-fill"></span></div>
          </div>
          <ul class="qrs-warnings no-print" id="qrs-warnings" aria-live="polite"></ul>
          <div class="qrs-export no-print">
            <div class="qrs-size-row">
              <label class="label" for="qrs-size-range" style="margin:0">PNG size</label>
              <input type="range" id="qrs-size-range" min="256" max="2048" step="64" value="1024" aria-label="PNG size in pixels" />
              <div class="qrs-size-num">
                <input type="number" class="input" id="qrs-size" min="256" max="2048" step="1" value="1024" aria-label="PNG size (pixels)" />
                <span class="small faint">px</span>
              </div>
            </div>
            <div class="qrs-actions">
              <button type="button" class="btn btn-primary" id="qrs-dl-png">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/></svg>
                PNG
              </button>
              <button type="button" class="btn" id="qrs-dl-svg">SVG</button>
              <button type="button" class="btn" id="qrs-copy-img">Copy image</button>
              <button type="button" class="btn" id="qrs-print">Print</button>
              <button type="button" class="btn btn-ghost" id="qrs-test" title="Decode the current design to make sure it still scans">Test scan</button>
            </div>
            <div id="qrs-test-result" class="small" role="status"></div>
          </div>
        </div>

        <div class="card qrs-style no-print">
          <h2 class="qrs-h"><span class="qrs-step">2</span> Style</h2>
          <div class="qrs-presets" role="group" aria-label="Colour presets" id="qrs-presets"></div>

          <div class="qrs-style-grid">
            <div class="field">
              <span class="label" id="qrs-mod-label">Modules</span>
              <div class="btn-group" role="group" aria-labelledby="qrs-mod-label" data-opt="module">
                <button type="button" class="btn btn-sm" data-val="square" aria-pressed="true">Square</button>
                <button type="button" class="btn btn-sm" data-val="rounded" aria-pressed="false">Rounded</button>
                <button type="button" class="btn btn-sm" data-val="dots" aria-pressed="false">Dots</button>
              </div>
            </div>
            <div class="field">
              <span class="label" id="qrs-eye-label">Finder eyes</span>
              <div class="btn-group" role="group" aria-labelledby="qrs-eye-label" data-opt="eye">
                <button type="button" class="btn btn-sm" data-val="square" aria-pressed="true">Square</button>
                <button type="button" class="btn btn-sm" data-val="rounded" aria-pressed="false">Rounded</button>
                <button type="button" class="btn btn-sm" data-val="circle" aria-pressed="false">Circle</button>
                <button type="button" class="btn btn-sm" data-val="leaf" aria-pressed="false">Leaf</button>
              </div>
            </div>
          </div>

          <div class="qrs-colors">
            <label class="qrs-color"><input type="color" id="qrs-fg" value="#111111" /> <span>Foreground</span></label>
            <label class="qrs-color" id="qrs-fg2-wrap" hidden><input type="color" id="qrs-fg2" value="#4f46e5" /> <span>Gradient end</span></label>
            <label class="qrs-color" id="qrs-bg-wrap"><input type="color" id="qrs-bg" value="#ffffff" /> <span>Background</span></label>
            <label class="qrs-color" id="qrs-eye-wrap" hidden><input type="color" id="qrs-eyec" value="#4f46e5" /> <span>Eyes</span></label>
          </div>
          <div class="row qrs-checks">
            <label class="checkbox"><input type="checkbox" id="qrs-gradient" /> Gradient</label>
            <select class="select qrs-gradtype" id="qrs-gradtype" aria-label="Gradient direction" hidden>
              <option value="diagonal">Diagonal</option>
              <option value="horizontal">Horizontal</option>
              <option value="vertical">Vertical</option>
              <option value="radial">Radial</option>
            </select>
            <label class="checkbox"><input type="checkbox" id="qrs-eye-custom" /> Eye colour</label>
            <label class="checkbox"><input type="checkbox" id="qrs-transparent" /> Transparent background</label>
          </div>

          <div class="qrs-style-grid">
            <div class="field">
              <label class="label" for="qrs-margin">Quiet zone <span class="faint" id="qrs-margin-val">4 modules</span></label>
              <input type="range" id="qrs-margin" min="0" max="10" step="1" value="4" />
            </div>
            <div class="field">
              <label class="label" for="qrs-ecl">Error correction</label>
              <select class="select" id="qrs-ecl">
                <option value="L">L · recovers ~7%</option>
                <option value="M" selected>M · recovers ~15%</option>
                <option value="Q">Q · recovers ~25%</option>
                <option value="H">H · recovers ~30%</option>
              </select>
              <span class="small faint" id="qrs-ecl-note" hidden>Locked to H while a logo is shown.</span>
            </div>
          </div>

          <div class="qrs-logo">
            <span class="label">Center logo</span>
            <div class="row">
              <button type="button" class="btn btn-sm" id="qrs-logo-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                <span id="qrs-logo-btn-text">Add image…</span>
              </button>
              <input type="file" id="qrs-logo-file" accept="image/*" hidden />
              <img id="qrs-logo-thumb" class="qrs-logo-thumb" alt="Logo preview" hidden />
              <span class="small muted grow" id="qrs-logo-name">PNG, JPG or SVG. Stays on your device.</span>
              <button type="button" class="btn btn-sm btn-ghost btn-danger" id="qrs-logo-remove" hidden>Remove</button>
            </div>
            <div class="qrs-logo-opts" id="qrs-logo-opts" hidden>
              <div class="field grow">
                <label class="label" for="qrs-logo-size">Logo size <span class="faint" id="qrs-logo-size-val">12% of area</span></label>
                <input type="range" id="qrs-logo-size" min="4" max="20" step="1" value="12" />
              </div>
              <label class="checkbox"><input type="checkbox" id="qrs-logo-plate" checked /> Background plate</label>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================ SCAN ============================ -->
    <section class="qrs-panel" data-tabpanel="qrs:scan" id="qrs-panel-scan" role="tabpanel" aria-labelledby="qrs-tab-scan" hidden>
      <div class="split qrs-scan">
        <div class="stack qrs-scan-col">
          <div class="card stack qrs-card-image">
            <h2 class="qrs-h" style="margin:0">From an image</h2>
            <div class="dropzone qrs-drop" id="qrs-drop" aria-label="Choose an image to scan">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
              <div><strong>Drop an image</strong> or click to choose</div>
              <div class="small">…or paste a screenshot with <kbd>Ctrl</kbd>+<kbd>V</kbd></div>
            </div>
            <div class="row">
              <button type="button" class="btn btn-sm" id="qrs-scan-sample">Try with the code from Create</button>
              <span class="small faint" id="qrs-engine"></span>
            </div>
            <div class="qrs-img-preview" id="qrs-img-preview" hidden><canvas id="qrs-img-canvas" aria-label="Scanned image with the detected code outlined"></canvas></div>
            <div class="alert" id="qrs-img-msg" role="status" hidden></div>
          </div>

          <div class="card stack qrs-card-camera">
            <div class="row-between">
              <h2 class="qrs-h" style="margin:0">Live camera</h2>
              <span class="badge" id="qrs-cam-state">Off</span>
            </div>
            <div class="qrs-cam-controls">
              <select class="select" id="qrs-cam-select" aria-label="Camera"><option value="">Default camera</option></select>
              <button type="button" class="btn btn-primary" id="qrs-cam-start">Start camera</button>
              <button type="button" class="btn" id="qrs-cam-stop" disabled>Stop</button>
              <button type="button" class="btn" id="qrs-cam-torch" aria-pressed="false" hidden>Torch</button>
            </div>
            <div class="qrs-video" id="qrs-video-wrap">
              <video id="qrs-video" playsinline muted aria-label="Camera preview"></video>
              <canvas id="qrs-overlay" aria-hidden="true"></canvas>
              <div class="qrs-video-off" id="qrs-video-off">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                <span>Camera is off. Frames are processed on this device only.</span>
              </div>
            </div>
            <div class="alert" id="qrs-cam-msg" role="status" hidden></div>
          </div>
        </div>

        <div class="stack qrs-scan-col">
          <div class="card qrs-card-result" id="qrs-result-card">
            <div class="row-between" style="margin-bottom:10px">
              <h2 class="qrs-h" style="margin:0">Result</h2>
              <span id="qrs-result-kind"></span>
            </div>
            <div id="qrs-result" aria-live="polite">
              <div class="qrs-result-empty muted">
                <p style="margin:0">Scan an image or point your camera at a QR code. Links are shown as text first; nothing opens until you choose to.</p>
              </div>
            </div>
          </div>
          <div class="card qrs-card-history">
            <div class="row-between" style="margin-bottom:8px">
              <h2 class="qrs-h" style="margin:0">This session</h2>
              <button type="button" class="btn btn-sm btn-ghost" id="qrs-history-clear" disabled>Clear</button>
            </div>
            <ol class="qrs-history" id="qrs-history" aria-label="Scan history"></ol>
            <p class="small faint qrs-history-empty" id="qrs-history-empty">Your scans appear here. They live only in memory and vanish when you close the tab.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { init } from '../../tools/qr-studio/main';
  init();
</script>

<style is:global>
  .qrs .tabs { margin-bottom: 16px; }
  .qrs .tab { display: inline-flex; align-items: center; gap: 6px; }
  .qrs .qrs-h { font-size: 1rem; display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .qrs .qrs-step {
    display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent); font-size: 0.75rem; font-weight: 700;
  }

  .qrs .qrs-grid {
    display: grid; gap: 16px; align-items: start;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    grid-template-areas: 'content preview' 'style preview';
  }
  .qrs .qrs-content { grid-area: content; }
  .qrs .qrs-style { grid-area: style; }
  .qrs .qrs-preview { grid-area: preview; position: sticky; top: calc(var(--header-h) + 12px); display: flex; flex-direction: column; gap: 12px; }
  @media (max-width: 900px) {
    .qrs .qrs-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'content' 'preview' 'style'; }
    .qrs .qrs-preview { position: static; }
  }

  .qrs .qrs-types { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; margin-bottom: 14px; }
  .qrs .qrs-type {
    display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 9px 6px;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elev); color: var(--text-muted);
    font: inherit; font-size: 0.8rem; font-weight: 550; cursor: pointer; transition: border-color .12s, background .12s, color .12s;
  }
  .qrs .qrs-type:hover { background: var(--bg-hover); color: var(--text); }
  .qrs .qrs-type[aria-checked='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .qrs .qrs-type svg { width: 18px; height: 18px; }

  .qrs .qrs-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; margin-bottom: 12px; }
  .qrs .qrs-form .qrs-full { grid-column: 1 / -1; }
  .qrs .qrs-form .textarea { min-height: 84px; }
  .qrs .qrs-form .qrs-hint { font-size: 0.75rem; color: var(--text-faint); }
  .qrs .qrs-form.is-locked { opacity: 0.55; pointer-events: none; }
  .qrs .qrs-pw { display: flex; gap: 6px; }
  @media (max-width: 520px) { .qrs .qrs-form { grid-template-columns: minmax(0, 1fr); } }

  .qrs .qrs-payload-box { border-top: 1px dashed var(--border); padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
  .qrs .qrs-payload { min-height: 70px; white-space: pre-wrap; word-break: break-all; background: var(--bg-sunken); }
  .qrs .qrs-payload:not([readonly]) { background: var(--bg-elev); border-color: var(--accent); }
  .qrs .qrs-payload-hint { margin: 0; }
  .qrs #qrs-form-error { margin-bottom: 12px; }

  .qrs .qrs-stage {
    position: relative; border-radius: var(--radius); padding: 18px;
    background-color: var(--bg-sunken);
    background-image: conic-gradient(var(--bg-hover) 25%, transparent 0 50%, var(--bg-hover) 0 75%, transparent 0);
    background-size: 18px 18px;
    display: grid; place-items: center; min-height: 260px;
  }
  .qrs .qrs-svg { width: 100%; max-width: 340px; line-height: 0; }
  .qrs .qrs-svg svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.08)); }
  .qrs .qrs-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--text-muted); text-align: center; max-width: 260px; font-size: 0.9rem; }
  .qrs .qrs-print-caption { display: none; }

  .qrs .qrs-bar { height: 6px; border-radius: 99px; background: var(--bg-sunken); overflow: hidden; margin-top: 4px; }
  .qrs .qrs-bar span { display: block; height: 100%; width: 0; background: var(--success); border-radius: inherit; transition: width .2s; }
  .qrs .qrs-bar.is-high span { background: var(--warning); }

  .qrs .qrs-warnings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .qrs .qrs-warnings:empty { display: none; }
  .qrs .qrs-warnings li { display: flex; gap: 8px; align-items: flex-start; }

  .qrs .qrs-export { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--border); padding-top: 12px; }
  .qrs .qrs-size-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .qrs .qrs-size-num { display: flex; align-items: center; gap: 4px; }
  .qrs .qrs-size-num .input { width: 82px; }
  .qrs .qrs-actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .qrs #qrs-test-result:empty { display: none; }

  .qrs .qrs-presets { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .qrs .qrs-preset {
    display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px 0 5px; border-radius: 99px;
    border: 1px solid var(--border); background: var(--bg-elev); color: var(--text); font: inherit; font-size: 0.8rem; cursor: pointer;
  }
  .qrs .qrs-preset:hover { background: var(--bg-hover); }
  .qrs .qrs-preset i { width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--border-strong); display: inline-block; }

  .qrs .qrs-style-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
  @media (max-width: 560px) { .qrs .qrs-style-grid { grid-template-columns: minmax(0, 1fr); } }
  .qrs .qrs-style .btn-group { flex-wrap: wrap; }
  .qrs .qrs-colors { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 10px; }
  .qrs .qrs-color { display: inline-flex; align-items: center; gap: 8px; font-size: 0.85rem; cursor: pointer; }
  .qrs .qrs-checks { gap: 6px 16px; margin-bottom: 14px; }
  .qrs .qrs-gradtype { width: auto; height: 32px; padding-top: 0; padding-bottom: 0; line-height: 1.2; font-size: 0.8rem; }
  .qrs .qrs-logo { border-top: 1px dashed var(--border); padding-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .qrs .qrs-logo .label { margin: 0; }
  .qrs .qrs-logo-thumb { width: 30px; height: 30px; object-fit: contain; border-radius: 6px; border: 1px solid var(--border); background: #fff; }
  .qrs .qrs-logo-opts { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; }

  /* Phones: show the result right after the image picker, before the camera. */
  @media (max-width: 860px) {
    .qrs .qrs-scan-col { display: contents; }
    .qrs .qrs-card-image { order: 1; }
    .qrs .qrs-card-result { order: 2; }
    .qrs .qrs-card-camera { order: 3; }
    .qrs .qrs-card-history { order: 4; }
  }
  .qrs .qrs-drop { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 26px 16px; }
  .qrs .qrs-img-preview { border-radius: var(--radius); background: var(--bg-sunken); padding: 8px; display: grid; place-items: center; }
  .qrs .qrs-img-preview canvas { max-height: 320px; width: auto; max-width: 100%; border-radius: 6px; }

  .qrs .qrs-cam-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 6px; }
  .qrs .qrs-cam-controls .btn[hidden] { display: none; }
  @media (max-width: 480px) { .qrs .qrs-cam-controls { grid-template-columns: minmax(0, 1fr) auto; } .qrs .qrs-cam-controls .select { grid-column: 1 / -1; } }
  .qrs .qrs-video { position: relative; aspect-ratio: 4 / 3; max-height: 380px; margin-inline: auto; width: 100%; background: #0b0b0d; border-radius: var(--radius); overflow: hidden; }
  .qrs .qrs-video video, .qrs .qrs-video canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .qrs .qrs-video-off { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #a0a0a8; text-align: center; padding: 16px; font-size: 0.875rem; }
  .qrs .qrs-video.is-on .qrs-video-off { display: none; }
  .qrs .qrs-video.is-hit { box-shadow: inset 0 0 0 3px var(--success); }

