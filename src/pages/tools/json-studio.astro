---
import ToolLayout from '../../layouts/ToolLayout.astro';

const i = {
  open: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  paste: '<path d="M9 4h6M9 4a2 2 0 0 0-2 2v0H5v15h14V6h-2a2 2 0 0 0-2-2M9 4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"/><path d="M9 12h6M9 16h4"/>',
  example: '<path d="M4 5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M14 3v5h5M8 13h8M8 17h5"/>',
  format: '<path d="M4 6h16M8 12h12M8 18h12M4 12h.01M4 18h.01"/>',
  minify: '<path d="M4 12h16M9 7l3 3 3-3M9 17l3-3 3 3"/>',
  sort: '<path d="M4 6h9M4 12h7M4 18h5M17 5v14M14 16l3 3 3-3"/>',
  escape: '<path d="M7 7l-4 5 4 5M17 7l4 5-4 5M14 5l-4 14"/>',
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/>',
  copy: '<rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M4 19h16"/>',
  clear: '<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  up: '<path d="M6 15l6-6 6 6"/>',
  down: '<path d="M6 9l6 6 6-6"/>',
  expand: '<path d="M7 9l5-5 5 5M7 15l5 5 5-5"/>',
  collapse: '<path d="M7 4l5 5 5-5M7 20l5-5 5 5"/>',
};
const ico = (d: string, s = 16) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const emptyState = `<div class="jss-out-empty" hidden><p><strong>Nothing to show yet.</strong></p><p class="muted small">Type or paste JSON on the left, drop a file anywhere, or start from the example.</p><div class="row"><button type="button" class="btn btn-sm btn-primary" data-cmd="example">Load example</button></div></div>`;
---
<ToolLayout slug="json-studio" wide>
  <div class="jss" id="jss">
    <div class="jss-toolbar" role="toolbar" aria-label="JSON actions">
      <div class="jss-tgroup">
        <div class="btn" id="jss-open" aria-label="Open a file" title="Open a .json, .yaml or .csv file (or drop one anywhere)"><Fragment set:html={ico(i.open)} /><span class="jss-hide-sm">Open</span></div>
        <button type="button" class="btn" data-cmd="paste" aria-label="Paste" title="Paste from the clipboard (YAML and CSV are converted)"><Fragment set:html={ico(i.paste)} /><span class="jss-hide-sm">Paste</span></button>
        <button type="button" class="btn" data-cmd="example" aria-label="Example" title="Load an example API response"><Fragment set:html={ico(i.example)} /><span class="jss-hide-sm">Example</span></button>
      </div>
      <div class="jss-tgroup">
        <label class="sr-only" for="jss-indent">Indentation</label>
        <select class="select jss-indent" id="jss-indent" title="Indentation used by Format, Sort keys, Fix it and the Tab key">
          <option value="2" selected>2 spaces</option>
          <option value="4">4 spaces</option>
          <option value="tab">Tabs</option>
        </select>
        <button type="button" class="btn btn-primary" data-cmd="format" title="Pretty-print the input (Shift+Alt+F)"><span class="jss-ico"><Fragment set:html={ico(i.format)} /></span><span>Format</span></button>
        <button type="button" class="btn" data-cmd="minify" title="Remove all whitespace"><span class="jss-ico"><Fragment set:html={ico(i.minify)} /></span><span>Minify</span></button>
        <button type="button" class="btn" data-cmd="sort" title="Sort object keys A→Z at every level"><span class="jss-ico"><Fragment set:html={ico(i.sort)} /></span><span>Sort<span class="jss-hide-sm"> keys</span></span></button>
      </div>
      <div class="jss-tgroup">
        <span class="btn-group" role="group" aria-label="String escaping">
          <button type="button" class="btn" data-cmd="escape" title="Turn the whole input into one JSON string literal"><span class="jss-ico"><Fragment set:html={ico(i.escape)} /></span><span>Escape</span></button>
          <button type="button" class="btn" data-cmd="unescape" title="Turn a JSON string literal back into its text">Unescape</button>
        </span>
      </div>
      <div class="jss-tgroup jss-tend">
        <button type="button" class="btn" data-cmd="share" aria-label="Share link" aria-disabled="false"><Fragment set:html={ico(i.share)} /><span class="jss-hide-sm">Share</span></button>
        <button type="button" class="btn btn-icon" data-cmd="copy" title="Copy the input" aria-label="Copy the input"><Fragment set:html={ico(i.copy)} /></button>
        <button type="button" class="btn btn-icon" data-cmd="download" title="Download the input as .json" aria-label="Download the input as .json"><Fragment set:html={ico(i.download)} /></button>
        <button type="button" class="btn btn-icon" data-cmd="clear" title="Clear the input" aria-label="Clear the input"><Fragment set:html={ico(i.clear)} /></button>
      </div>
    </div>

    <div class="alert alert-error jss-msg" id="jss-msg" role="alert" hidden></div>
    <div class="alert alert-success jss-fixed" id="jss-fixed" role="status" hidden>
      <span id="jss-fixed-text"></span>
      <button type="button" class="btn btn-sm" data-cmd="undo">Undo</button>
    </div>

    <div class="jss-main">
      <section class="panel jss-in" aria-label="Input">
        <div class="jss-head">
          <h2 class="jss-title">Input</h2>
          <span class="small faint jss-hide-sm">JSON, YAML or CSV</span>
          <span class="grow"></span>
          <span class="small faint jss-cursor" id="jss-cursor" aria-live="off">Ln 1, Col 1</span>
        </div>
        <div class="jss-editor" id="jss-editor">
          <div class="jss-gutter" aria-hidden="true"><div class="jss-gutter-inner"></div></div>
          <div class="jss-ta-wrap">
            <div class="jss-errband" hidden></div>
            <textarea id="jss-input" class="jss-ta" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" wrap="off" aria-label="JSON input" aria-describedby="jss-editor-help" placeholder="Paste or type JSON here, or drop a .json / .yaml / .csv file"></textarea>
          </div>
        </div>
        <div class="jss-big" hidden>
          <div class="jss-big-note small">
            <span><strong>Large document (<span id="jss-big-size"></span>).</strong> Shown read-only so the page stays fast. Format, minify, convert and explore it as usual.</span>
            <button type="button" class="btn btn-sm" data-cmd="edit-large" title="Load the text into the editor. Typing in multi-megabyte text can be slow.">Edit anyway</button>
          </div>
          <div class="jss-code jss-big-view" id="jss-big-view" aria-label="Input, read-only large document" role="region"></div>
        </div>
        <div class="jss-dropnote" aria-hidden="true">Drop to open</div>
        <p class="sr-only" id="jss-editor-help">Tab indents and Shift+Tab outdents. Press Escape, then Tab, to move focus out of the editor.</p>
      </section>

      <section class="panel jss-out" aria-label="Output">
        <div class="jss-out-head">
          <div class="tabs jss-tabs" role="tablist" data-tabs="out" aria-label="Output view">
            <button type="button" class="tab" role="tab" data-tab="formatted" aria-selected="true">Formatted</button>
            <button type="button" class="tab" role="tab" data-tab="tree" aria-selected="false">Tree</button>
            <button type="button" class="tab" role="tab" data-tab="yaml" aria-selected="false">YAML</button>
            <button type="button" class="tab" role="tab" data-tab="csv" aria-selected="false">CSV</button>
            <button type="button" class="tab" role="tab" data-tab="ts" aria-selected="false">TypeScript</button>
          </div>
          <div class="jss-out-actions">
            <button type="button" class="btn btn-sm" data-cmd="out-copy" title="Copy this output"><Fragment set:html={ico(i.copy, 14)} /><span>Copy</span></button>
            <button type="button" class="btn btn-sm" data-cmd="out-download" title="Download this output"><Fragment set:html={ico(i.download, 14)} /><span class="jss-hide-sm">Download</span></button>
          </div>
        </div>
        <div class="jss-stale small" id="jss-stale" hidden>The input has an error. Showing the last valid version.</div>

        <div class="jss-pane" data-tabpanel="out:formatted">
          <Fragment set:html={emptyState} />
          <div class="jss-out-body"><div class="jss-code" id="jss-fmt-view" aria-label="Formatted JSON" role="region"></div></div>
        </div>

        <div class="jss-pane" data-tabpanel="out:tree" hidden>
          <Fragment set:html={emptyState} />
          <div class="jss-out-body">
            <div class="jss-bar">
              <div class="jss-search">
                <Fragment set:html={ico(i.search, 15)} />
                <label class="sr-only" for="jss-search">Search keys and values</label>
                <input class="input" id="jss-search" type="search" placeholder="Search keys and values" autocomplete="off" spellcheck="false" />
                <span class="small muted jss-search-count" id="jss-search-count" aria-live="polite"></span>
              </div>
              <span class="btn-group">
                <button type="button" class="btn btn-sm btn-icon" id="jss-search-prev" title="Previous match (Shift+Enter)" aria-label="Previous match"><Fragment set:html={ico(i.up, 15)} /></button>
                <button type="button" class="btn btn-sm btn-icon" id="jss-search-next" title="Next match (Enter)" aria-label="Next match"><Fragment set:html={ico(i.down, 15)} /></button>
              </span>
              <span class="btn-group">
                <button type="button" class="btn btn-sm" id="jss-expand" title="Expand all" aria-label="Expand all"><Fragment set:html={ico(i.expand, 14)} /><span class="jss-hide-md">Expand all</span></button>
                <button type="button" class="btn btn-sm" id="jss-collapse" title="Collapse all" aria-label="Collapse all"><Fragment set:html={ico(i.collapse, 14)} /><span class="jss-hide-md">Collapse</span></button>
              </span>
              <span class="jss-copies small">
                <span class="muted jss-hide-md">Click copies</span>
                <span class="btn-group" role="group" aria-label="Clicking a node copies">
                  <button type="button" class="btn btn-sm" data-copies="jsonpath" aria-pressed="true">JSONPath</button>
                  <button type="button" class="btn btn-sm" data-copies="js" aria-pressed="false">JS</button>
                </span>
              </span>
            </div>
            <div class="jss-tree" id="jss-tree" aria-label="JSON tree. Arrow keys move, Space toggles, Enter copies the path."></div>
            <div class="jss-path" id="jss-path" hidden>
              <div class="jss-path-row"><span class="jss-path-k">JSONPath</span><code id="jss-path-jp"></code><button type="button" class="btn btn-sm" id="jss-copy-jp">Copy</button></div>
              <div class="jss-path-row"><span class="jss-path-k">JS</span><code id="jss-path-js"></code><button type="button" class="btn btn-sm" id="jss-copy-js">Copy</button></div>
            </div>
          </div>
        </div>

        <div class="jss-pane" data-tabpanel="out:yaml" hidden>
          <Fragment set:html={emptyState} />
          <div class="jss-out-body">
            <div class="alert alert-error jss-out-error" id="jss-yaml-error" hidden></div>
            <div class="jss-code" id="jss-yaml-view" aria-label="YAML" role="region"></div>
          </div>
        </div>

        <div class="jss-pane" data-tabpanel="out:csv" hidden>
          <Fragment set:html={emptyState} />
          <div class="jss-out-body">
            <div class="jss-bar">
              <label class="jss-field"><span class="small muted">Rows</span><select class="select" id="jss-csv-rows"></select></label>
              <label class="jss-field"><span class="small muted">Delimiter</span>
                <select class="select" id="jss-csv-delim">
                  <option value=",">Comma ,</option>
                  <option value=";">Semicolon ;</option>
                  <option value="tab">Tab</option>
                  <option value="|">Pipe |</option>
                </select>
              </label>
              <span class="small muted" id="jss-csv-info"></span>
            </div>
            <div class="alert alert-error jss-out-error" id="jss-csv-error" hidden></div>
            <div class="jss-code" id="jss-csv-view" aria-label="CSV" role="region"></div>
            <p class="small faint jss-foot">Nested objects become dot columns (<code>address.city</code>), arrays get indexes (<code>roles.0</code>). Paste the CSV back into the input to rebuild the JSON.</p>
          </div>
        </div>

        <div class="jss-pane" data-tabpanel="out:ts" hidden>
          <Fragment set:html={emptyState} />
          <div class="jss-out-body">
            <div class="jss-bar">
              <label class="jss-field"><span class="small muted">Root name</span><input class="input jss-ts-root" id="jss-ts-root" value="Root" spellcheck="false" autocomplete="off" /></label>
              <label class="jss-field"><span class="small muted">Declare with</span>
                <select class="select" id="jss-ts-style"><option value="interface">interface</option><option value="type">type</option></select>
              </label>
              <label class="checkbox"><input type="checkbox" id="jss-ts-ro" /> readonly</label>
            </div>
            <div class="jss-code" id="jss-ts-view" aria-label="TypeScript" role="region"></div>
          </div>
        </div>
      </section>
    </div>

    <div class="jss-stats small" id="jss-stats" aria-live="polite">
      <span class="badge" id="jss-valid">Empty</span>
      <span><span class="faint">Size</span> <strong data-stat="size">0 B</strong></span>
      <span><span class="faint">Keys</span> <strong data-stat="keys">–</strong></span>
      <span><span class="faint">Max depth</span> <strong data-stat="depth">–</strong></span>
      <span><span class="faint">Arrays</span> <strong data-stat="arrays">–</strong></span>
      <span><span class="faint">Root</span> <strong data-stat="type">–</strong></span>
      <span class="grow"></span>
      <span class="faint" id="jss-share-note"></span>
      <span class="faint jss-hide-sm">Everything stays in this tab.</span>
    </div>
  </div>
</ToolLayout>

<script>
  import { init } from '../../tools/json-studio/main';
  init();
</script>

<style is:global>
  body .jss { --jss-h: clamp(460px, calc(100vh - 300px), 1000px); display: flex; flex-direction: column; gap: 10px; }
  body .jss-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 8px; }
  body .jss-tgroup { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
  body .jss-tgroup + .jss-tgroup { padding-left: 8px; border-left: 1px solid var(--border); }
  body .jss-tend { margin-left: auto; }
  body .jss-toolbar .btn svg { flex: none; }
  body .jss-toolbar .btn-icon { width: 34px; }
  body .jss-indent { width: auto; }
  body .jss-ico { display: inline-flex; }
  body #jss-open { gap: 6px; }
  body #jss-open.is-dragover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  body [data-cmd='share'][aria-disabled='true'] { opacity: 0.5; cursor: not-allowed; }

  body .jss-msg { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  body .jss-msg-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1 1 320px; }
  body .jss-msg-title { font-weight: 600; }
  body .jss-msg-pos { font-family: var(--font-mono); font-size: 0.8rem; padding: 1px 6px; margin-right: 4px; border-radius: 4px; background: color-mix(in srgb, currentColor 12%, transparent); }
  body .jss-msg-hint { color: var(--text); opacity: 0.85; }
  body .jss-msg-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  body .jss-fixed { display: flex; gap: 12px; align-items: center; justify-content: space-between; }

  body .jss-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; height: var(--jss-h); }
  body .jss-in { position: relative; }
  body .jss-main > .panel { min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
  body .jss-head { display: flex; align-items: center; gap: 10px; padding: 0 12px; height: 41px; border-bottom: 1px solid var(--border); flex: none; }
  body .jss-cursor { font-variant-numeric: tabular-nums; white-space: nowrap; }
  body .jss-title { margin: 0; font-size: 0.9rem; font-weight: 650; }

  /* Editor: textarea + virtualized gutter. Line height and top padding match editor.ts (20px / 10px). */
  body .jss-editor { position: relative; flex: 1; min-height: 0; display: flex; background: var(--bg-elev); }
  body .jss-gutter { flex: none; width: var(--jss-gw, 4.5ch); overflow: hidden; position: relative; background: var(--bg-sunken); border-right: 1px solid var(--border); font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); user-select: none; }
  body .jss-gutter-inner { position: absolute; left: 0; right: 0; top: 0; will-change: transform; }
  body .jss-gutter-inner > div { height: 20px; line-height: 20px; text-align: right; padding-right: 8px; font-variant-numeric: tabular-nums; }
  body .jss-gutter-inner > .is-error { color: var(--danger); background: var(--danger-soft); font-weight: 700; }
  body .jss-ta-wrap { position: relative; flex: 1; min-width: 0; overflow: hidden; }
  body .jss-ta { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; border: 0; outline: none; resize: none; padding: 10px 12px; font-family: var(--font-mono); font-size: 13px; line-height: 20px; tab-size: 2; white-space: pre; overflow: auto; background: transparent; color: var(--text); font-variant-ligatures: none; caret-color: var(--accent); }
  body .jss-in:focus-within { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  body .jss-ta::placeholder { color: var(--text-faint); }
  body .jss-errband { position: absolute; left: 0; right: 0; top: 0; height: 20px; background: color-mix(in srgb, var(--danger) 14%, transparent); border-left: 3px solid var(--danger); pointer-events: none; }
  body .jss-big { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  body .jss-big-note { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 12px; background: var(--accent-soft); color: var(--text); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  body .jss-cv-line.is-error { background: color-mix(in srgb, var(--danger) 14%, transparent); }
  body .jss-cv-line.is-error .jss-cv-ln { color: var(--danger); font-weight: 700; }
  body .jss-dropnote { display: none; position: absolute; inset: 49px 8px 8px; border: 2px dashed var(--accent); border-radius: var(--radius); background: color-mix(in srgb, var(--accent-soft) 85%, transparent); color: var(--accent); font-weight: 650; align-items: center; justify-content: center; pointer-events: none; }
  body .jss.is-dragover .jss-dropnote { display: flex; }

  /* Output */
  body .jss-out-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--border); padding: 0 8px 0 4px; flex: none; min-height: 41px; }
  body .jss-tabs { border-bottom: 0; min-width: 0; }
  body .jss-tabs .tab { padding-top: 10px; padding-bottom: 9px; white-space: nowrap; }
  body .jss-out-actions { display: flex; gap: 4px; align-self: center; flex: none; }
  body .jss-out-actions .btn { gap: 5px; }
  body .jss-stale { padding: 6px 12px; background: var(--warning-soft); color: var(--warning); border-bottom: 1px solid var(--border); }
  body .jss-pane { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  body .jss-out-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  body .jss-out-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; }
  body .jss-out-empty p { margin: 0 0 6px; }
  body .jss-out-error { margin: 8px; }
  body .jss-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 8px 10px; border-bottom: 1px solid var(--border); flex: none; }
  body .jss-bar .select, body .jss-bar .input { height: 30px; font-size: 0.82rem; }
  body .jss-field { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  body .jss-field .select { max-width: 260px; }
  body .jss-ts-root { width: 140px; }
  body .jss-foot { margin: 0; padding: 6px 12px; border-top: 1px solid var(--border); }
  body .jss-foot code { font-size: 0.78rem; }

  /* Virtualized code view (codeview.ts uses 20px lines with 8px top padding). */
  body .jss-code { flex: 1; min-height: 0; }
  body .jss-cv { position: relative; overflow: auto; font-family: var(--font-mono); font-size: 13px; outline-offset: -2px; background: var(--bg-elev); }
  body .jss-cv-inner { position: relative; min-width: 100%; }
  body .jss-cv-line { position: absolute; left: 0; right: 0; height: 20px; line-height: 20px; white-space: pre; display: flex; }
  body .jss-cv-ln { position: sticky; left: 0; flex: none; width: var(--jss-gutter, 4ch); padding-right: 10px; margin-right: 10px; text-align: right; color: var(--text-faint); background: var(--bg-sunken); border-right: 1px solid var(--border); font-size: 12px; user-select: none; font-variant-numeric: tabular-nums; box-sizing: content-box; }
  body .jss-cv-line:first-child .jss-cv-ln { box-shadow: 0 -8px 0 var(--bg-sunken); }
  body .jss-cv-code { tab-size: 2; padding-right: 16px; }
  body .jss-hk { color: var(--c1); }
  body .jss-hs { color: var(--c5); }
  body .jss-hn { color: var(--c3); }
  body .jss-hb { color: var(--c4); }
  body .jss-hl { color: var(--text-faint); font-style: italic; }
  body .jss-hkw { color: var(--c6); font-weight: 600; }
  :root:not([data-theme='dark']) body .jss-hs { color: #15803d; }
  :root:not([data-theme='dark']) body .jss-hn { color: #b45309; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) body .jss-hs { color: var(--c5); } :root:not([data-theme='light']) body .jss-hn { color: var(--c3); } }

  /* Tree */
  body .jss-search { position: relative; display: flex; align-items: center; flex: 1 1 180px; min-width: 150px; }
  body .jss-search > svg { position: absolute; left: 9px; color: var(--text-faint); pointer-events: none; }
  body .jss-search .input { width: 100%; padding-left: 30px; padding-right: 76px; }
